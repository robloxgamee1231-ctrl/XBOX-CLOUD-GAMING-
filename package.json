{
  "name": "psbox-cloud-gaming-web",
  "version": "1.0.0",
  "description": "PSBox Cloud Gaming for Browser — Xbox Cloud Gaming & Remote Play web client with Microsoft Account sign-in",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc --noEmit -p tsconfig.server.json",
    "build:pages": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/xcloud.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
